# Скопировать в .env: cp .env.example .env

# Сервис
SERVICE_NAME=mykct-api

# Логирование
# debug | info | warn | error. При LOG_LEVEL != debug gin переходит в release mode
LOG_LEVEL=debug
# true - человекочитаемый вывод в консоль, false - JSON (для прода)
LOG_PRETTY=true

# HTTP-сервер
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
# Бюджет graceful shutdown. В docker-compose stop_grace_period должен быть больше
SHUTDOWN_TIMEOUT=20s
# Лимит заголовков запроса в мегабайтах
HTTP_MAX_HEADER_BYTES=1
# CIDR/IP прокси, чьему X-Forwarded-For можно верить. По умолчанию подсеть Docker
TRUSTED_PROXIES=172.16.0.0/12

# MongoDB
# Локальная Mongo из docker-compose.dev.yml поднята как replica set rs0, и
# rs.initiate прописывает primary как mongo:27017 - это имя резолвится только
# внутри сети compose. Поэтому с хоста подключаться строго с directConnection=true,
# иначе драйвер зависнет на выборе сервера. Транзакции при этом работают.
MONGO_URI=mongodb://localhost:27017/?directConnection=true
MONGO_DATABASE=mykct
MONGO_CONNECT_TIMEOUT=10s
MONGO_SERVER_SELECTION_TIMEOUT=5s
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=0
MONGO_MAX_CONN_IDLE_TIME=5m

# Sentry (опционально: пустой DSN - сервис работает без Sentry)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_DEBUG=false

# CORS
# Список origin через запятую, точное совпадение
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting (in-memory, на один инстанс)
RATE_LIMIT_ENABLED=true
# Запросов за окно с одного IP и допустимый всплеск
RATE_LIMIT_IP_RATE=100
RATE_LIMIT_IP_BURST=200
RATE_LIMIT_WINDOW_SECONDS=60

# Аутентификация
# Ключ подписи access-токенов. Сгенерировать: openssl rand -base64 32
AUTH_JWT_SIGNING_KEY=
# Access - короткоживущий JWT, refresh - opaque-токен, в базе лежит только его хэш
AUTH_ACCESS_TOKEN_TTL=60m
AUTH_REFRESH_TOKEN_TTL=720h
# true - вход без похода в LDAP с заглушкой пользователя. Только для разработки
AUTH_TEST_MODE=false

# LDAP колледжа (не нужен при AUTH_TEST_MODE=true)
LDAP_URL=ldap://10.3.0.33:389
LDAP_BASE_DN=dc=it-college,dc=ru
# Ветки дерева, к каждой приклеивается LDAP_BASE_DN
LDAP_STUDENTS_OU=ou=people
LDAP_TEACHERS_OU=ou=people,ou=Teachers
LDAP_GROUPS_OU=ou=Current
# Префикс uid преподавателя, все остальные uid считаются студенческими
LDAP_TEACHER_UID_PREFIX=t
LDAP_TIMEOUT=5s

# Расписание
# Портал колледжа, откуда берётся расписание. Виден только из сети колледжа
SCHEDULE_PORTAL_URL=https://students.it-college.ru
# Таймаут запроса к порталу. Без него зависший портал не даст откатиться на кэш
SCHEDULE_PORTAL_TIMEOUT=15s
# Сколько снимок расписания живёт в кэше и отдаётся, пока портал недоступен
SCHEDULE_CACHE_TTL=720h

# Посещаемость
# Портал колледжа, откуда берётся посещаемость студента. Кэша нет: портал
# недоступен - клиент получает 503
ATTENDANCE_PORTAL_URL=https://students.it-college.ru
ATTENDANCE_PORTAL_TIMEOUT=15s

# Анонимный рейтинг по серии посещений. Наружу отдаются только псевдонимы:
# ни логинов, ни ФИО, ни учебных групп
ATTENDANCE_LEADERBOARD_ENABLED=false
# Секрет HMAC для псевдонимов. Обязателен при ENABLED=true, минимум 32 символа.
# Сгенерировать: openssl rand -base64 32. Без него логины вида i24s0291
# перебираются, и таблица псевдоним-логин строится за секунды. Смена секрета
# перетасовывает все псевдонимы разом - это кнопка на случай утечки таблицы
ATTENDANCE_LEADERBOARD_ALIAS_SECRET=
# Сколько строк отдаётся в топе. Чем длиннее таблица, тем проще разобрать её по
# внешним наблюдениям, поэтому не весь курс
ATTENDANCE_LEADERBOARD_TOP_SIZE=10
# Пока на курсе меньше участников, рейтинг не показывается: в выборке из пяти
# человек псевдонимы разбираются с первого взгляда. Меньше 5 сервис не примет.
# Должен быть строго больше TOP_SIZE, иначе на пороговой когорте в топ уходит
# весь курс целиком
ATTENDANCE_LEADERBOARD_MIN_PARTICIPANTS=15
# Воркер пересчёта серий: пауза между прогонами и размер одного прогона.
# Подбор: BATCH_SIZE >= Участники * REFRESH_INTERVAL / REFRESH_TTL
ATTENDANCE_LEADERBOARD_REFRESH_INTERVAL=1h
ATTENDANCE_LEADERBOARD_BATCH_SIZE=40
# Серия свежее этого срока не пересчитывается: студент, открывший приложение
# сам, уже освежил свою строку
ATTENDANCE_LEADERBOARD_REFRESH_TTL=6h
# Пауза между студентами, чтобы не бить по порталу пачкой
ATTENDANCE_LEADERBOARD_STUDENT_DELAY=2s
# Пустых ответов портала подряд, после которых логин считается погасшим
# (отчислен, сменил группу) и убирается из рейтинга до следующего входа
ATTENDANCE_LEADERBOARD_EMPTY_RUNS_LIMIT=5

# Воркер расписания: детект появления недели и изменений внутри неё
SCHEDULE_WATCH_ENABLED=false
# Как часто опрашивать портал в дни, когда расписание выкладывают, и в остальные.
# Второй интервал задаёт и задержку, с которой замечается изменение в расписании
SCHEDULE_WATCH_ACTIVE_INTERVAL=15m
SCHEDULE_WATCH_IDLE_INTERVAL=30m
SCHEDULE_WATCH_ACTIVE_DAYS=Fri,Sat,Sun
# Пауза между группами, чтобы не бить по порталу пачкой запросов
SCHEDULE_WATCH_GROUP_DELAY=500ms
# Должен быть больше недели, за которой следит состояние, иначе статус пропадёт
# прямо посреди слежения. Меньше 8 дней сервис не примет
SCHEDULE_WATCH_STATE_TTL=720h

# Успеваемость
# Портал колледжа, откуда берутся предметы и оценки студента. Кэша нет: портал
# недоступен - клиент получает 503
PERFORMANCE_PORTAL_URL=https://students.it-college.ru
PERFORMANCE_PORTAL_TIMEOUT=15s
